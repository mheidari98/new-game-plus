---
const { title, tagline } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={tagline} />
  <style is:global>
    @import '../styles/tokens.css';

    /* --card and --free were the old names for --surface and --good. Aliased
       rather than renamed at every call site in one go, so this commit stays
       reviewable; the aliases go when the last page is ported. */
    :root { --card: var(--surface); --free: var(--good); }

    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--fg);
      font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    .wrap { max-width: 62rem; margin: 0 auto; padding: 0 1.25rem; }
    header { border-bottom: 1px solid var(--line); padding: 1.25rem 0; }
    header nav { display: flex; gap: 1.25rem; align-items: baseline; flex-wrap: wrap; }
    header a { color: inherit; text-decoration: none; }
    .brand { font-weight: 700; letter-spacing: -0.02em; }
    header nav a:not(.brand) { color: var(--muted); font-size: 0.95rem; }
    header nav a:not(.brand):hover { color: var(--accent); }
    h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.15; letter-spacing: -0.03em; margin: 2rem 0 0.5rem; }
    .lede { color: var(--muted); font-size: 1.1rem; max-width: 46rem; }
    footer { border-top: 1px solid var(--line); margin-top: 4rem; padding: 2rem 0; color: var(--muted); font-size: 0.9rem; }
    footer a { color: var(--accent); }
    code { background: var(--card); border: 1px solid var(--line); border-radius: 4px; padding: 0.1em 0.35em; font-size: 0.9em; }

    /* Shared list and badge styles. Global, not per page: an island builds its
       markup at runtime, and Astro's scoped styles only reach elements it
       rendered itself. Pages override where they deliberately differ. */
    .note { color: var(--muted); font-size: 0.95rem; }
    .loading { color: var(--muted); }
    .free { color: var(--free); font-weight: 600; }
    .meta { display: block; color: var(--muted); font-size: 0.85rem; }
    .rows { padding-left: 1.2rem; }
    .rows li { margin: 0.55rem 0; }
    .rows a { color: inherit; text-decoration: none; font-weight: 600; }
    .rows a:hover { color: var(--accent); text-decoration: underline; }
    .tag { border: 1px solid var(--line); border-radius: 999px;
           padding: 0.05em 0.5em; font-size: 0.78rem; margin-left: 0.35rem; }
    .tag.in, .tag.low, .tag.good { border-color: var(--good); color: var(--good); }
    s { opacity: 0.6; }

    /* The focus ring is a token and is never removed. :where() keeps
       specificity at zero so a page can restyle the element without having to
       out-specify this rule and accidentally drop the ring. */
    :where(a, button, input, select, summary, [tabindex]):focus-visible {
      outline: var(--focus-ring) solid var(--accent);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }

    /* Visible only once focused, so a keyboard user can jump the nav. */
    .skip {
      position: absolute; left: -9999px;
      background: var(--surface); color: var(--fg);
      border: 1px solid var(--line); border-radius: var(--radius);
      padding: 0.6rem 1rem; z-index: 10;
    }
    .skip:focus { left: 1rem; top: 1rem; }

    /* Prices, scores, hours and player counts sit in columns, so figures must
       not change width between rows. */
    .num, table td, table th { font-variant-numeric: tabular-nums; }

    .theme-toggle {
      margin-left: auto; background: none; border: 1px solid var(--line);
      color: var(--muted); border-radius: var(--radius); cursor: pointer;
      font: inherit; font-size: 0.85rem; padding: 0.2rem 0.6rem;
    }
    .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }

    .visually-hidden {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip-path: inset(50%); white-space: nowrap;
    }

    /* One game's page. Shared here rather than in either page, because the
       markup is rendered twice: prerendered for the popular games, in the
       browser for the tail. */
    /* Cover art. Every <img> carries width/height so the box is reserved
       before the image lands and nothing shifts. Sizes are requested from the
       CDN, not scaled down here -- a 400 KB asset shrunk in CSS is still
       400 KB over the wire. */
    .cardart { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px;
               display: block; margin-bottom: 0.5rem; background: var(--line); }
    .withart { display: flex; gap: 0.7rem; align-items: center; }
    .thumb { width: 56px; height: 56px; flex: none; border-radius: 5px;
             object-fit: cover; background: var(--line); }
    .gamepage .cover { float: right; width: 220px; max-width: 38%; height: auto;
                       aspect-ratio: 1; object-fit: cover; border-radius: 8px;
                       margin: 0 0 1rem 1.25rem; background: var(--line); }
    @media (max-width: 34rem) {
      .gamepage .cover { float: none; width: 160px; max-width: 50%; margin: 0 0 1rem; }
    }

    .gamepage h2 { font-size: 1.15rem; letter-spacing: -0.02em; margin: 2rem 0 0.5rem; }
    .gamepage .price { font-size: 1.2rem; margin: 0.5rem 0 1.5rem; }
    .gamepage .price s { opacity: 0.6; font-size: 0.9rem; }
    .gamepage .off { color: var(--free); font-weight: 600; font-size: 0.9rem; }
    .gamepage .free { color: var(--free); font-weight: 700; }
    .gamepage .tag { border: 1px solid var(--line); border-radius: 999px;
                     padding: 0.1em 0.6em; font-size: 0.8rem; margin-left: 0.4rem;
                     white-space: nowrap; }
    .gamepage .tag.in { border-color: var(--free); color: var(--free); }
    .gamepage .facts { display: grid; gap: 0; margin: 0; }
    .gamepage .fact { display: grid; grid-template-columns: minmax(9rem, 16rem) 1fr;
                      gap: 1rem; padding: 0.45rem 0; border-top: 1px solid var(--line); }
    .gamepage dt { color: var(--muted); font-size: 0.9rem; }
    .gamepage dd { margin: 0; }
    .gamepage .note { color: var(--muted); font-size: 0.95rem; margin-top: 1rem; }
    .gamepage .buy { color: var(--accent); font-weight: 600; }
    @media (max-width: 34rem) {
      .gamepage .fact { grid-template-columns: 1fr; gap: 0; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header><div class="wrap"><nav>
    <a class="brand" href={base}>new-game-plus</a>
    <a href={`${base}free/`}>Free games</a>
    <a href={`${base}plus/`}>Is PS+ worth it?</a>
    {/* Becomes /explore/ when that route lands; /couch/ joins it later. Nav
        only ever points at routes that exist. */}
    <a href={`${base}deals/`}>Deals</a>
    <button class="theme-toggle" id="theme-toggle" type="button">Theme</button>
  </nav></div></header>
  <main class="wrap" id="main" tabindex="-1"><slot /></main>
  <footer><div class="wrap">
    <p>
      Prices from the US PlayStation Store, refreshed daily. Not affiliated with Sony.
      <a href="https://github.com/mheidari98/new-game-plus">Source</a>.
    </p>
    <p>
      Price history starts when this project did, so it is shallow.
      <a href="https://platprices.com">PlatPrices</a> has tracked PSN prices since 2020
      and shipped a PS+ calculator before this existed.
    </p>
  </div></footer>

  <script>
    import { nextTheme, resolveTheme, type Theme } from '../lib/theme';

    const KEY = 'ngp:theme';
    const read = () => {
      try { return localStorage.getItem(KEY); } catch { return null; }   // private mode
    };
    const write = (theme: Theme) => {
      try { localStorage.setItem(KEY, theme); } catch { /* private mode */ }
    };

    const button = document.getElementById('theme-toggle') as HTMLButtonElement;
    let theme = resolveTheme(read(), matchMedia('(prefers-color-scheme: dark)').matches);

    // The label names what a click will *do*, not the current state -- a button
    // reading "Dark theme" while the page is dark is the classic ambiguity.
    const apply = (next: Theme) => {
      theme = next;
      document.documentElement.dataset.theme = next;
      button.textContent = next === 'dark' ? 'Light theme' : 'Dark theme';
    };

    apply(theme);
    button.addEventListener('click', () => { const next = nextTheme(theme); write(next); apply(next); });
  </script>
</body>
</html>
