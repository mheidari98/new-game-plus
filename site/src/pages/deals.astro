---
// /deals/ was the explorer's old name. Kept as a redirect because the URL is
// linked from the README and from anything anyone has already shared.
const base = import.meta.env.BASE_URL;
const target = `${base}explore/`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <link rel="canonical" href={target} />
  <title>Moved to Explore</title>
</head>
<body><p>This page is now at <a href={target}>Explore</a>.</p></body>
</html>
