---
import Base from '../layouts/Base.astro';
import { artUrl, decode, esrbLabel } from '../lib/index';
import { gameUrl } from '../lib/detail';
import raw from '../../public/index.json';
import art from '../art.json';
const { rows } = decode(raw);
const base = import.meta.env.BASE_URL;
// Row order is popularity order, and it decides which games have a
// prerendered page, so the rank is taken before any sorting.
const rankOf = new Map(rows.map((r, i) => [r.id, i]));
const free = rows.filter((r) => r.is_free || r.price_cents === 0)
  .sort((a, b) => b.quality - a.quality);
---
<Base title="Free PS5 and PS4 games" tagline="Games that cost nothing, permanently.">
  <h1>Free games</h1>
  <p class="lede">
    These cost nothing for everyone, permanently — no subscription. Ranked by store
    rating, so the ones people actually like are first.
  </p>
  <p class="note">
    Most free-to-play games are online-only, which is why almost none of them show a
    local player count. That field is genuinely absent rather than unknown.
  </p>
  <ol class="rows freelist">
    {free.map((g) => (
      <li>
        {/* Inner wrapper, not display:flex on the li: that drops the ::marker
            and this list is ranked, so the numbers carry meaning. */}
        <div class="withart">
          {artUrl(art[g.id], 100) && (
            <img class="thumb" src={artUrl(art[g.id], 100)} alt="" width="56" height="56"
                 loading="lazy" decoding="async" />
          )}
          <span>
            <a href={gameUrl(base, g.id, rankOf.get(g.id)!)}>{g.name}</a>
            <span class="meta">
              {g.genres.slice(0, 2).join(' · ')}
              {g.esrb && <> · {esrbLabel(g.esrb)}</>}
              {g.quality > 0 && <> · quality {Math.round(g.quality)}</>}
            </span>
          </span>
        </div>
      </li>
    ))}
  </ol>
  {free.length === 0 && <p>No free games in this snapshot yet.</p>}
  <style is:global>
    .lede { margin-bottom: 0.5rem; }
    /* The rank is a counter rather than a list marker: ::marker aligns to the
       row's line box, which sits at the bottom of a 56px thumbnail. As a flex
       item it centres with the art. */
    .freelist { list-style: none; counter-reset: rank; padding-left: 0;
                margin-top: 1.5rem; }
    .freelist li { counter-increment: rank; }
    .freelist .withart::before {
      content: counter(rank) "."; color: var(--muted); font-size: 0.85rem;
      flex: none; min-width: 2.5ch; text-align: right;
    }
  </style>
</Base>
